{
  // CMake Tools (WSL Remote) configuration for this project
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": true,
  "cmake.configureArgs": [
    "-DCMAKE_BUILD_TYPE=Debug",
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "-DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc",
    "-DVLLM_PYTHON_EXECUTABLE=/usr/bin/python3"
  ],
  // If you're using MS C/C++ extension, point IntelliSense at CMake's compile database.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  // Recommended when using clangd: avoid running two semantic engines at once.
  // (Keep the extension installed if you still use its debugger / tasks.)
  "C_Cpp.intelliSenseEngine": "disabled",
  // If you're using clangd (including Kylin Clangd), these are critical for CUDA projects.
  // - compile_commands is generated into build/
  // - most entries use nvcc; clangd needs query-driver to understand nvcc's system includes/flags
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--query-driver=/usr/local/cuda/bin/nvcc,/usr/bin/*g++*,/usr/bin/*clang*",
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--pch-storage=memory",
    "-j=8"
  ],
  // Ensure .cu/.cuh are treated as CUDA/C++ so clangd attaches and provides completion.
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  },
  // Convenience: some tools expect compile_commands.json at the workspace root.
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  // Formatting: use .clang-format in repo root for C/C++/CUDA.
  // Requires clangd extension: llvm-vs-code-extensions.vscode-clangd
  "editor.formatOnSave": true,
  "[c]": {
    "editor.defaultFormatter": "KylinIdeTeam.kylin-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "KylinIdeTeam.kylin-clangd"
  },
  "[cuda-cpp]": {
    "editor.defaultFormatter": "KylinIdeTeam.kylin-clangd"
  },
  // Python IntelliSense (Pylance)
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.variableTypes": false
}